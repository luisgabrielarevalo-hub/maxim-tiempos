# Google Sheets · cuenta de servicio
GOOGLE_SHEETS_SPREADSHEET_ID=tu_spreadsheet_id

# Local: ruta al JSON de la cuenta de servicio (no lo subas al repo).
# En despliegues sin sistema de archivos (Vercel) esta variable no sirve.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json

# Despliegue, opción 1: el JSON completo en una variable (admite base64).
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":...}'

# Despliegue, opción 2: email + clave con \n escapados.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=servicio@proyecto.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase · proyecto uvuwrtytwvfdfrpiveod
NEXT_PUBLIC_SUPABASE_URL=https://uvuwrtytwvfdfrpiveod.supabase.co

# Publishable key (Dashboard → Settings → API Keys). Puede ir al cliente.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (Dashboard → Settings → API Keys). Solo servidor: nunca con prefijo
# NEXT_PUBLIC_ ni expuesta al cliente. Obligatoria para el registro.
SUPABASE_SECRET_KEY=sb_secret_...
